# ── Supabase (client) ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Email (Resend) ──────────────────────────────────────────────────────────
VITE_RESEND_API_KEY=your-resend-key

# ── Stripe (client) ─────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Price IDs created in the Stripe dashboard (test mode)
VITE_STRIPE_PRICE_MONTHLY=price_xxx
VITE_STRIPE_PRICE_ANNUAL=price_xxx

# ── Stripe (server — Vercel serverless functions in /api) ───────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx

# ── Supabase (server — service role, used by webhook to update subscriptions) ─
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL used for Stripe redirect callbacks
APP_URL=http://localhost:5173
